cpu_harness only: the flush hook for the CPU test harness (harness-x2).

Applied to a harness build tree only, never to an 86Box build and never
committed under src/, as scripts/harness-fast-reset.diff is. It adds the
pointer mem_test_hook (386_common.c) and calls it, when set, at the points
where an instruction has read a lookup entry and is about to use it:
checkio()'s word and byte reads (sites 1, 2, 386_ops.h) and a string op's
translate step, interpreted (do_mmut_hit(), 386_common.h) and in the
compiled REP loop (REP_MMUT, codegen_ops_rep.c) (sites 3 source, 4
destination). cpu_harness --flush-at <site>:<n> then flushes the lookup
tables from another thread at the n-th call of that site in a run. Without
the patch cpu_harness refuses --flush-at; every other output is the same.

Apply from the top of the tree: git apply scripts/harness-flush-hook.diff

diff --git a/src/codegen/codegen_ops_rep.c b/src/codegen/codegen_ops_rep.c
index 56d552d70..083c3fb7d 100644
--- a/src/codegen/codegen_ops_rep.c
+++ b/src/codegen/codegen_ops_rep.c
@@ -34,6 +34,8 @@
                 (hit)      = e_;                                            \
                 (hit_page) = lin_ >> 12;                                    \
                 (a64)[0]   = MMUT_UNWALKED;                                 \
+                if (mem_test_hook)                                          \
+                    mem_test_hook((write) ? 4 : 3);                         \
             }                                                               \
         }                                                                   \
     } while (0)
diff --git a/src/cpu/386_common.c b/src/cpu/386_common.c
index d892c5fa7..fadb5eaa0 100644
--- a/src/cpu/386_common.c
+++ b/src/cpu/386_common.c
@@ -247,6 +247,8 @@ uint32_t addr64_2;
 uint32_t addr64a[8];
 uint32_t addr64a_2[8];
 
+void (*mem_test_hook)(int site) = NULL;
+
 uintptr_t mmut_hit_r  = (uintptr_t) LOOKUP_INV;
 uintptr_t mmut_hit_r2 = (uintptr_t) LOOKUP_INV;
 uintptr_t mmut_hit_w  = (uintptr_t) LOOKUP_INV;
diff --git a/src/cpu/386_common.h b/src/cpu/386_common.h
index f45bbc163..b6a7d59a8 100644
--- a/src/cpu/386_common.h
+++ b/src/cpu/386_common.h
@@ -22,6 +22,14 @@
 #include <stddef.h>
 #include <inttypes.h>
 
+/* For the CPU test harness only, from scripts/harness-flush-hook.diff: called
+   at the points where a lookup entry has been read and is about to be used,
+   so the harness can flush the tables from another thread right there.
+   Sites: 1 checkio() word read, 2 checkio() byte read, 3 a string op's
+   source (or other read) translate step, 4 its destination. */
+#define CPU_HAS_MEM_TEST_HOOK
+extern void (*mem_test_hook)(int site);
+
 #ifdef OPS_286_386
 #    define readmemb_n(s, a, b)     readmembl_no_mmut_2386((s) + (a), b)
 #    define readmemw_n(s, a, b)     readmemwl_no_mmut_2386((s) + (a), b)
@@ -160,6 +168,8 @@ do_mmut_hit(uintptr_t *hit, uint32_t *hit_page, uint32_t set, uint32_t s, uint32
         b[0]      = MMUT_UNWALKED;
         *hit      = e;
         *hit_page = addr >> 12;
+        if (mem_test_hook)
+            mem_test_hook(write ? 4 : 3);
     } else if (s == 0xFFFFFFFF)
         do_mmutranslate_nh(addr, b, num, write);
     else if (set)
diff --git a/src/cpu/386_ops.h b/src/cpu/386_ops.h
index eca098603..20120e81d 100644
--- a/src/cpu/386_ops.h
+++ b/src/cpu/386_ops.h
@@ -247,6 +247,8 @@ checkio_readw(uint32_t base, uint32_t off)
         return readmemwl_no_mmut_nh(addr, addr64a_2);
     }
     e = *(volatile uintptr_t *) &readlookup2[addr >> 12];
+    if (mem_test_hook)
+        mem_test_hook(1);
     if ((e != (uintptr_t) LOOKUP_INV) && !(addr & 1))
         return *(uint16_t *) (e + addr);
     if (do_mmut_needed())
@@ -266,6 +268,8 @@ checkio_readb(uint32_t base, uint32_t off)
         return readmembl_no_mmut_nh(addr, addr64a_2[0]);
     }
     e = *(volatile uintptr_t *) &readlookup2[addr >> 12];
+    if (mem_test_hook)
+        mem_test_hook(2);
     if (e != (uintptr_t) LOOKUP_INV)
         return *(uint8_t *) (e + addr);
     if (do_mmut_needed())
